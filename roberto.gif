-rgb),.5) !important; }

body.e2e { --font-family-monospace: DejaVu Sans Mono; }

body.e2e [data-testid]:hover { outline: solid 1px rgba(var(--primary-strong=
-rgb),.5) !important; }

body.e2e [data-testid]:hover::before { opacity: 1; }

body.e2e [data-testid]::before { content: attr(data-testid); color: var(--W=
DS-background-wash-plain); position: absolute; white-space: nowrap; z-index=
: 1000; background-color: var(--WDS-content-default); border-radius: 5px; b=
order: 1px solid var(--WDS-background-wash-plain); padding: 3px; font-size:=
 8pt; line-height: 8px; pointer-events: none; left: 50%; top: 0px; transfor=
m: translate(-50%); width: max-content; height: max-content; transition: op=
acity 0.2s ease-in-out; opacity: 0; }

body.e2e [data-testrobot]:hover { outline: orangered dotted 2px !important;=
 }

body.e2e [data-testrobot]:hover::after { opacity: 1; }

body.e2e [data-testrobot]::after { content: attr(data-testrobot); color: va=
r(--WDS-background-wash-plain); position: absolute; white-space: nowrap; z-=
index: 1000; background-color: rgb(255, 69, 0); border-radius: 5px; border:=
 1px solid var(--WDS-background-wash-plain); padding: 3px; font-size: 8pt; =
line-height: 8px; pointer-events: none; left: 0px; top: 0px; transform: tra=
nslate(0px); width: max-content; height: max-content; transition: opacity 0=
.2s ease-in-out; opacity: 0; }

.emoji.apple { background-size: 100px 100px; }

.emojik.apple { background-size: 160px 160px; }

.emoji.apple.b151 { background-size: 80px 100px; }

.emojik.apple.b151 { background-size: 128px 160px; }

.emoji.wa { background-size: 100px 100px; }

.emojik.wa { background-size: 160px 160px; }

.emoji.wa.b151 { background-size: 40px 80px; }

.emojik.wa.b151 { background-size: 64px 128px; }

.emoji, .emojik { display: inline-block; vertical-align: top; zoom: 1; bord=
er: 0px; }

code .emoji { vertical-align: middle; }

.emoji { width: 20px; height: 20px; image-rendering: -webkit-optimize-contr=
ast; }

.emoji.apple { margin-right: 1px; margin-left: 1px; }

.emojik { width: 32px; height: 32px; image-rendering: -webkit-optimize-cont=
rast; }

.safari-fix .emoji, .safari-fix .emojik { image-rendering: unset; }

